<Page x:Class="Oficina.FolhasObra"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Folhas de Obra"
      Style="{StaticResource PageBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Gestão de Folhas de Obra" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Adicione novas folhas de obra!"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource FormCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cliente" Style="{StaticResource FormLabel}" Grid.Row="0" Grid.Column="0"/>
                    <ComboBox x:Name="comboCliente"
                              Grid.Row="0" Grid.Column="1"
                              Margin="0,0,16,0"
                              Style="{StaticResource FormComboBox}"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="Id"/>

                    <TextBlock Text="Data Entrada" Style="{StaticResource FormLabel}" Grid.Row="0" Grid.Column="2"/>
                    <DatePicker x:Name="dpDataEntrada"
                                Grid.Row="0" Grid.Column="3"
                                Style="{StaticResource FormDatePicker}"/>

                    <TextBlock Text="Matrícula" Style="{StaticResource FormLabel}" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="txtMatricula"
                             Grid.Row="1" Grid.Column="1"
                             Margin="0,0,16,0"
                             Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Marca" Style="{StaticResource FormLabel}" Grid.Row="1" Grid.Column="2"/>
                    <ComboBox x:Name="comboMarca"
                              Grid.Row="1" Grid.Column="3"
                              Style="{StaticResource FormComboBox}"/>

                    <TextBlock Text="Modelo" Style="{StaticResource FormLabel}" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="txtModelo" Grid.Row="2" Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Km" Style="{StaticResource FormLabel}" Grid.Row="2" Grid.Column="2"/>
                    <TextBox x:Name="txtKm"
                             Grid.Row="2" Grid.Column="3"
                             Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Problema" Style="{StaticResource FormLabel}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtProblema"
                             Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             Style="{StaticResource FormTextBoxMultiline}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Serviços" Style="{StaticResource FormLabel}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtServicos"
                             Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                             Style="{StaticResource FormTextBoxMultiline}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Estado" Style="{StaticResource FormLabel}" Grid.Row="5" Grid.Column="0"/>
                    <ComboBox x:Name="comboEstado"
                              Grid.Row="5" Grid.Column="1"
                              Margin="0,0,16,0"
                              Style="{StaticResource FormComboBox}"/>

                    <TextBlock Text="Valor Total" Style="{StaticResource FormLabel}" Grid.Row="5" Grid.Column="2"/>
                    <TextBox x:Name="txtValor" Grid.Row="5" Grid.Column="3" Style="{StaticResource FormTextBox}"/>

                    <StackPanel Grid.Row="6" Grid.ColumnSpan="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="Adicionar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="btnAdicionar_Click"/>
                        <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="btnAtualizar_Click"/>
                        <Button Content="Apagar" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="btnApagar_Click"/>
                        <Button Content="Limpar" Style="{StaticResource GhostButton}" Click="btnLimpar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource FormCard}" Margin="0,0,0,12" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Pesquisar matrícula"
                               Style="{StaticResource FormLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBox x:Name="txtPesquisa"
                             Width="200"
                             Style="{StaticResource FormTextBox}"
                             Margin="0,0,8,0"/>
                    <Button Content="Pesquisar"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="btnPesquisar_Click"/>
                    <Button Content="Mostrar Todos"
                            Style="{StaticResource GhostButton}"
                            Click="btnMostrarTodos_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource FormCard}" Padding="0">
                <DataGrid x:Name="dgFolhasObra"
                          Style="{StaticResource StyledDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="dgFolhasObra_SelectionChanged"
                          BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Folha" Binding="{Binding Id}" Width="68"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="*"/>
                        <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="100"/>
                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="110"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="110"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat={}{0:N2} €}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
