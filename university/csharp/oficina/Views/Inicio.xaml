<Page x:Class="Oficina.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Início"
      Style="{StaticResource PageBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
                <TextBlock Text="Bem-vindo"
                           Style="{StaticResource PageTitle}"
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtDataHoje"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextoSuave}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Clientes" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="txtTotalClientes" Text="0" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Abertas" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="txtFolhasAbertas" Text="0" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Em Reparação" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="txtEmReparacao" Text="0" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Concluídas" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="txtConcluidas" Text="0" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource FormCard}" Margin="0,0,0,16" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="+ Novo Cliente"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="btnNovoCliente_Click"/>
                    <Button Content="+ Nova Folha de Obra"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="btnNovaFolha_Click"/>
                    <Button Content="Ver Clientes"
                            Style="{StaticResource GhostButton}"
                            Click="btnVerClientes_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Últimas entradas" Style="{StaticResource PageTitle}" FontSize="16"/>
            </StackPanel>

            <Border Grid.Row="4" Style="{StaticResource FormCard}" Padding="0" MinHeight="200">
                <DataGrid x:Name="dgUltimasEntradas"
                          Style="{StaticResource StyledDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataEntrada, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="*"/>
                        <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="90"/>
                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="100"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="100"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat={}{0:N2} €}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
