<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores-->
    <Color x:Key="CorPrimaria">#2B2B2B</Color>
    <Color x:Key="CorPrimariaEscura">#1A1A1A</Color>
    <Color x:Key="CorAccent">#E30613</Color>
    <Color x:Key="CorAccentHover">#B8000D</Color>
    <Color x:Key="CorFundo">#EDEDED</Color>
    <Color x:Key="CorSuperficie">#FFFFFF</Color>
    <Color x:Key="CorTexto">#1F1F1F</Color>
    <Color x:Key="CorTextoSuave">#6B6B6B</Color>
    <Color x:Key="CorBorda">#C8C8C8</Color>
    <Color x:Key="CorPerigo">#8B0000</Color>
    <Color x:Key="CorPerigoHover">#6B0000</Color>
    <Color x:Key="CorSucesso">#E30613</Color>

    <SolidColorBrush x:Key="BrushPrimaria" Color="{StaticResource CorPrimaria}"/>
    <SolidColorBrush x:Key="BrushPrimariaEscura" Color="{StaticResource CorPrimariaEscura}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource CorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource CorAccentHover}"/>
    <SolidColorBrush x:Key="BrushFundo" Color="{StaticResource CorFundo}"/>
    <SolidColorBrush x:Key="BrushSuperficie" Color="{StaticResource CorSuperficie}"/>
    <SolidColorBrush x:Key="BrushTexto" Color="{StaticResource CorTexto}"/>
    <SolidColorBrush x:Key="BrushTextoSuave" Color="{StaticResource CorTextoSuave}"/>
    <SolidColorBrush x:Key="BrushBorda" Color="{StaticResource CorBorda}"/>
    <SolidColorBrush x:Key="BrushPerigo" Color="{StaticResource CorPerigo}"/>
    <SolidColorBrush x:Key="BrushPerigoHover" Color="{StaticResource CorPerigoHover}"/>
    <SolidColorBrush x:Key="BrushSucesso" Color="{StaticResource CorSucesso}"/>

    <!-- Buttons -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushSucesso}"/>
        <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushPrimaria}"/>
        <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushPerigo}"/>
        <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushBorda}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonAccent" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Labels -->
    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaria}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Inputs -->
    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormTextBoxMultiline" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <!-- Cards -->
    <Style x:Key="FormCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="StyledDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="30"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushPrimaria}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimariaEscura}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFE8E8"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Background da pagina -->
    <Style x:Key="PageBackground" TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BrushFundo}"/>
    </Style>

    <!-- Dashboard -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaria}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

</ResourceDictionary>
