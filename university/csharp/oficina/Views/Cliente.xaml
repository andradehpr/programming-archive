<Page x:Class="Oficina.Clientes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clientes"
      Style="{StaticResource PageBackground}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="Gestão de Clientes"
                       Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FormCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nome*" Style="{StaticResource FormLabel}" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="txtNome" Grid.Row="0" Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Telefone" Style="{StaticResource FormLabel}" Grid.Row="0" Grid.Column="2"/>
                <TextBox x:Name="txtTelefone"
                         Grid.Row="0" Grid.Column="3"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Email" Style="{StaticResource FormLabel}" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="txtEmail"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,0,16,0"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="NIF" Style="{StaticResource FormLabel}" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txtNIF"
                         Grid.Row="1" Grid.Column="3"
                         Style="{StaticResource FormTextBox}"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button Content="Adicionar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="btnAdicionar_Click"/>
                    <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="btnAtualizar_Click"/>
                    <Button Content="Apagar" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="btnApagar_Click"/>
                    <Button Content="Limpar" Style="{StaticResource GhostButton}" Click="btnLimpar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormCard}" Margin="0,0,0,12" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Pesquisar"
                           Style="{StaticResource FormLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="txtPesquisa"
                         Width="280"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,0,8,0"/>
                <Button Content="Pesquisar"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="btnPesquisar_Click"/>
                <Button Content="Mostrar Todos"
                        Style="{StaticResource GhostButton}"
                        Click="btnMostrarTodos_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FormCard}" Padding="0">
            <DataGrid x:Name="dgClientes"
                      Style="{StaticResource StyledDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgClientes_SelectionChanged"
                      BorderThickness="0">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Cli." Binding="{Binding Id}" Width="58"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="130"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
